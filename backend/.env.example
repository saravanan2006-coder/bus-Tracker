# --- App ----------------------------------------------------------------
APP_NAME=BusTracker
ENVIRONMENT=dev
DEBUG=false
API_PREFIX=/api/v1

# --- Database ------------------------------------------------------------
# Production: postgresql+asyncpg://user:pass@host:5432/bustracker
# Local dev/tests: sqlite+aiosqlite:///./bus_tracker.db
DATABASE_URL=sqlite+aiosqlite:///./bus_tracker.db
USE_POSTGIS=false

# --- Redis ----------------------------------------------------------------
# Production: redis://default:pass@host:6379/0
# Leave empty (or unset REDIS_ENABLED=false) to use the in-memory fallback.
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# --- Security ---------------------------------------------------------------
# CRITICAL: generate a long random secret in production: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
ADMIN_API_KEY=change-me-admin

# --- SMS --------------------------------------------------------------------
# console | msg91 | twilio
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=BUSTKR

# --- Routing ----------------------------------------------------------------
OSRM_BASE_URL=https://router.project-osrm.org
ROUTE_SNAP_THRESHOLD_M=1500

# --- Tracking ----------------------------------------------------------------
STALE_AFTER_SECONDS=60
MAX_LOCATION_RATE_PER_SECOND=1
ANOMALY_MAX_SPEED_KMH=130
ANOMALY_OFF_ROUTE_THRESHOLD_M=3000
